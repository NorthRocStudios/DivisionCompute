
#pragma kernel Execute

struct MyDataStruct
{
    float3 position;
    float value;
};

Buffer<float> InputBuffer;
RWBuffer<float> OutputBuffer;
StructuredBuffer<MyDataStruct> DataBuffer;
Texture2D<float4> InputTexture;
RWTexture2D<float4> OutputTexture;

float3 _cameraPosition;
float _time;

[numthreads(8, 8, 1)]
void Execute(uint3 id : SV_DispatchThreadID)
{
    float4 color = InputTexture[id.xy];
    float processed = color.r * _time;
    OutputBuffer[id.x] = processed;
    OutputTexture[id.xy] = float4(processed, processed, processed, 1.0);
}